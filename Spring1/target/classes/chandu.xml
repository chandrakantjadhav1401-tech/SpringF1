<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <bean  id="service" class="com.classes.PaymentServices">
    
    <constructor-arg ref="debit"></constructor-arg>
    
    <constructor-arg ref="UPI"></constructor-arg>
    
    </bean>
    
    
    
    
    <bean  id="debit" class="com.classes.DebitCard"></bean>
    
    <bean  id="credit" class="com.classes.CreditCard"></bean>
    
    
    
    <bean  id="UPI" class="com.classes.UPIPayment"></bean>

</beans>